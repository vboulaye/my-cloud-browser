# Public client ID from a Microsoft Entra SPA app registration (personal accounts).
PUBLIC_MICROSOFT_CLIENT_ID=

# Optional. Defaults to this site's origin + SvelteKit base path + '/'.
# The resulting exact URL must be registered as a Single-page application redirect URI.
PUBLIC_MICROSOFT_REDIRECT_URI=

# Optional for GitHub Pages project sites; use the repository path, e.g. /my-cloud-browser.
BASE_PATH=
